{
  "schema_version": 1,
  "skill": "data-viz",
  "class": "generative",
  "trigger": {
    "positive": [
      "Data needs a chart, table, uncertainty treatment, or accessible comparison."
    ],
    "negative": [
      "There is no data subject or the request is only a decorative illustration."
    ],
    "adjacent_skills": [
      "art-direction",
      "a11y-pass",
      "empty-states"
    ]
  },
  "exclusions": [
    "Do not choose a chart before identifying the comparison task.",
    "Do not hide uncertainty, sparse data, or a table fallback."
  ],
  "inputs": {
    "required": [
      "data shape and provenance",
      "comparison question",
      "audience and accessibility constraints"
    ],
    "optional": [
      "sample data",
      "brand tokens",
      "performance budget"
    ]
  },
  "outputs": {
    "primary": "honest chart/table recommendation and implementation plan",
    "artifacts": [
      "genre decision",
      "encoding and parity plan",
      "uncertainty/accessibility notes",
      "evidence-backed self-check"
    ],
    "handoff_fields": [
      "question",
      "genre",
      "encoding",
      "uncertainty",
      "fallback",
      "evidence"
    ]
  },
  "stop_conditions": [
    "Stop when the data provenance or comparison question is missing.",
    "Stop when a requested chart would materially mislead; recommend a safer form."
  ],
  "handoff": {
    "receives_from": [
      "color-system",
      "design-system-interview",
      "improve-existing-website",
      "tasteroll"
    ],
    "sends_to": [
      "a11y-pass",
      "empty-states",
      "tastecheck-pass"
    ]
  },
  "self_check_shape": "table_with_evidence",
  "required_evidence_fields": [
    "status",
    "reason",
    "remediation",
    "evidence",
    "provenance"
  ],
  "context_budget": {
    "skill_md_max_tokens": 5000,
    "resource_max_tokens": 6000
  }
}

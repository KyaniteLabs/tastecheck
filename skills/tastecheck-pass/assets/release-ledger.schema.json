{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tastecheck.dev/contracts/v1/release-ledger.schema.json",
  "title": "TasteCheck release ledger input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact", "rows"],
  "properties": {
    "schema_version": { "const": 1 },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifact": { "$ref": "#/$defs/artifact" },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifact": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path"],
          "properties": { "type": { "const": "file" }, "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/sha256" }, "bytes": { "type": "integer", "minimum": 0 } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path"],
          "properties": { "type": { "const": "directory" }, "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/sha256" }, "bytes": { "type": "integer", "minimum": 0 } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "url", "sha256"],
          "properties": { "type": { "const": "url" }, "url": { "type": "string", "pattern": "^https://" }, "sha256": { "$ref": "#/$defs/sha256" } }
        }
      ]
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill", "check_id", "status", "reason", "remediation", "evidence", "provenance"],
      "properties": {
        "skill": { "const": "tastecheck-pass" },
        "check_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pass", "fail", "n/a"] },
        "reason": { "type": "string", "minLength": 1 },
        "remediation": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/evidence" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "summary", "details", "sha256"],
      "properties": {
        "mode": { "enum": ["automated", "manual"] },
        "summary": { "type": "string", "minLength": 1 },
        "details": {},
        "subject": { "type": "string", "minLength": 1 },
        "subject_absent": { "type": "boolean" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_identity", "artifact_sha256", "captured_at", "tool", "browser", "inspector", "sha256"],
      "properties": {
        "artifact_identity": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "captured_at": { "type": "string", "format": "date-time" },
        "tool": { "$ref": "#/$defs/runtime" },
        "browser": { "$ref": "#/$defs/runtime" },
        "inspector": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/inspector" }] },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } }
    },
    "inspector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "method"],
      "properties": { "name": { "type": "string", "minLength": 1 }, "role": { "type": "string", "minLength": 1 }, "method": { "type": "string", "minLength": 1 } }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tastecheck.dev/contracts/v1/release-ledger.schema.json",
  "title": "TasteCheck release ledger input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact", "subject_inventory", "rows"],
  "properties": {
    "schema_version": { "const": 1 },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifact": { "$ref": "#/$defs/artifact" },
    "execution": { "$ref": "#/$defs/execution" },
    "subject_inventory": { "$ref": "#/$defs/subject_inventory" },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifact": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path", "dependency_manifest"],
          "properties": { "type": { "const": "file" }, "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/sha256" }, "bytes": { "type": "integer", "minimum": 0 }, "dependency_manifest": { "$ref": "#/$defs/dependencyManifest" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path", "dependency_manifest"],
          "properties": { "type": { "const": "directory" }, "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/sha256" }, "bytes": { "type": "integer", "minimum": 0 }, "dependency_manifest": { "$ref": "#/$defs/dependencyManifest" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "url", "sha256"],
          "properties": { "type": { "const": "url" }, "url": { "type": "string", "pattern": "^https://" }, "sha256": { "$ref": "#/$defs/sha256" } }
        }
      ]
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill", "check_id", "status", "reason", "remediation", "evidence", "provenance"],
      "properties": {
        "skill": { "const": "tastecheck-pass" },
        "check_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pass", "fail", "n/a"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "remediation": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "evidence": { "$ref": "#/$defs/evidence" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "review": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/review" }] }
      }
    },
    "subject_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frozen_at", "subjects", "coverage", "sha256"],
      "properties": {
        "frozen_at": { "type": "string", "format": "date-time" },
        "subjects": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "coverage": { "type": "object", "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/inventoryMember" } } },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "inventoryMember": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "route": { "type": "string", "minLength": 1 }, "state": { "type": "string", "minLength": 1 }, "viewport": { "type": "integer", "minimum": 1 }, "control": { "type": "string", "minLength": 1 } }
    },
    "dependencyManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "assets", "sha256"],
      "properties": {
        "entry": { "type": "string", "minLength": 1 },
        "assets": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"], "properties": { "path": { "type": "string", "minLength": 1 }, "bytes": { "type": "integer", "minimum": 1 }, "sha256": { "$ref": "#/$defs/sha256" } } } },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "summary", "details", "sha256"],
      "properties": {
        "mode": { "enum": ["automated", "manual"] },
        "summary": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "details": { "$ref": "#/$defs/safeValue" },
        "subject": { "type": "string", "minLength": 1, "maxLength": 256 },
        "subject_absent": { "type": "boolean" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_identity", "artifact_sha256", "dependency_manifest_sha256", "subject_inventory_sha256", "captured_at", "tool", "browser", "inspector", "sha256"],
      "properties": {
        "artifact_identity": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "dependency_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "subject_inventory_sha256": { "$ref": "#/$defs/sha256" },
        "captured_at": { "type": "string", "format": "date-time" },
        "tool": { "$ref": "#/$defs/runtime" },
        "browser": { "$ref": "#/$defs/runtime" },
        "inspector": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/inspector" }] },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } }
    },
    "inspector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "method"],
      "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 256 }, "role": { "type": "string", "minLength": 1, "maxLength": 256 }, "method": { "type": "string", "minLength": 1, "maxLength": 256 } }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "target_origin", "authenticated", "writes", "injection", "authorization"],
      "properties": {
        "mode": { "enum": ["audit", "fix"] },
        "target_origin": { "enum": ["repo", "staging", "production"] },
        "authenticated": { "type": "boolean" },
        "writes": { "type": "boolean" },
        "injection": { "type": "boolean" },
        "authorization": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/authorization" }] }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "approved_by", "approved_at", "expires_at", "reason"],
      "properties": {
        "scope": { "enum": ["target-origin-audit", "target-origin-fix"] },
        "approved_by": { "type": "string", "minLength": 1, "maxLength": 256 },
        "approved_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "artifact_sha256", "evidence_sha256", "reviewer", "rubric", "independent", "decision", "disagreement", "adjudication", "reviewed_at", "sha256"],
      "properties": {
        "check_id": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "evidence_sha256": { "$ref": "#/$defs/sha256" },
        "reviewer": { "$ref": "#/$defs/reviewer" },
        "rubric": { "$ref": "#/$defs/rubric" },
        "independent": { "const": true },
        "decision": { "enum": ["pass", "fail", "n/a"] },
        "disagreement": { "type": "boolean" },
        "adjudication": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/adjudication" }] },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "role", "method"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "type": { "const": "human" },
        "role": { "type": "string", "minLength": 1, "maxLength": 256 },
        "method": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "criteria"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "criteria": { "$ref": "#/$defs/safeValue" }
      }
    },
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adjudicator", "rule", "decision", "resolved_at", "rationale"],
      "properties": {
        "adjudicator": { "$ref": "#/$defs/reviewer" },
        "rule": { "type": "string", "minLength": 1, "maxLength": 256 },
        "decision": { "enum": ["pass", "fail", "n/a"] },
        "resolved_at": { "type": "string", "format": "date-time" },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "safeValue": {
      "anyOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string", "maxLength": 4096 },
        { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/safeValue" } },
        {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": { "not": { "enum": ["__proto__", "prototype", "constructor"] } },
          "additionalProperties": { "$ref": "#/$defs/safeValue" }
        }
      ]
    }
  }
}

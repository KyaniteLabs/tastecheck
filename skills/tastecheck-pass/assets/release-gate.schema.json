{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tastecheck.dev/contracts/v1/release-gate.schema.json",
  "title": "TasteCheck release gate output v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "roots", "catalog", "subject_inventory", "artifact", "execution", "rows", "verdict", "release_eligible", "blockers", "validation"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "tastecheck-release-gate" },
    "roots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verifier", "artifact"],
      "properties": {
        "verifier": { "$ref": "#/$defs/rootIdentity" },
        "artifact": { "$ref": "#/$defs/rootIdentity" }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "check_ids"],
      "properties": { "path": { "type": "string" }, "sha256": { "$ref": "#/$defs/sha256" }, "check_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } } }
    },
    "subject_inventory": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["frozen_at", "subjects", "coverage", "sha256"],
          "properties": { "frozen_at": { "type": "string" }, "subjects": { "type": "array", "items": { "type": "string" } }, "coverage": { "type": "object" }, "sha256": { "$ref": "#/$defs/sha256" } }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "identity", "sha256", "bytes", "hash_verified", "dependency_manifest", "dependency_manifest_sha256", "dependency_manifest_hash_verified"],
      "properties": { "type": { "enum": ["file", "directory", "url"] }, "identity": { "type": "string" }, "root_identity": { "$ref": "#/$defs/rootIdentity" }, "sha256": { "$ref": "#/$defs/sha256" }, "bytes": { "type": "integer", "minimum": 0 }, "hash_verified": { "type": "boolean" }, "dependency_manifest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/dependencyManifest" }] }, "dependency_manifest_sha256": { "$ref": "#/$defs/sha256" }, "dependency_manifest_hash_verified": { "type": "boolean" } }
    },
    "execution": { "$ref": "#/$defs/execution" },
    "rows": { "type": "array", "items": { "$ref": "#/$defs/outputRow" } },
    "verdict": { "enum": ["SHIP", "HOLD"] },
    "release_eligible": { "type": "boolean" },
    "blockers": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_valid", "execution_policy_valid", "catalog_complete", "subject_inventory_valid", "subject_coverage_complete", "artifact_hash_verified", "artifact_dependency_manifest_verified", "evidence_hashes_verified", "provenance_hashes_verified", "errors"],
      "properties": { "input_valid": { "type": "boolean" }, "execution_policy_valid": { "type": "boolean" }, "catalog_complete": { "type": "boolean" }, "subject_inventory_valid": { "type": "boolean" }, "subject_coverage_complete": { "type": "boolean" }, "artifact_hash_verified": { "type": "boolean" }, "artifact_dependency_manifest_verified": { "type": "boolean" }, "evidence_hashes_verified": { "type": "boolean" }, "provenance_hashes_verified": { "type": "boolean" }, "errors": { "type": "array", "items": { "type": "string" } } }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "outputRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill", "check_id", "status", "reason", "remediation", "evidence", "provenance", "review", "validation_errors"],
      "properties": {
        "skill": { "const": "tastecheck-pass" },
        "check_id": { "type": "string" },
        "status": { "enum": ["pass", "fail", "n/a"] },
        "reason": { "type": "string" },
        "remediation": { "type": "string" },
        "evidence": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/evidence" }] },
        "provenance": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/provenance" }] },
        "review": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/review" }] },
        "validation_errors": { "type": "array", "items": { "type": "string" } }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "target_origin", "authenticated", "writes", "injection", "authorization"],
      "properties": {
        "mode": { "enum": ["audit", "fix"] },
        "target_origin": { "enum": ["repo", "staging", "production"] },
        "authenticated": { "type": "boolean" },
        "writes": { "type": "boolean" },
        "injection": { "type": "boolean" },
        "authorization": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/authorization" }] }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "approved_by", "approved_at", "expires_at", "reason"],
      "properties": {
        "scope": { "enum": ["target-origin-audit", "target-origin-fix"] },
        "approved_by": { "type": "string" },
        "approved_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "reason": { "type": "string" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "artifact_sha256", "evidence_sha256", "reviewer", "rubric", "independent", "decision", "disagreement", "adjudication", "reviewed_at", "sha256"],
      "properties": {
        "check_id": { "type": "string" },
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "evidence_sha256": { "$ref": "#/$defs/sha256" },
        "reviewer": { "$ref": "#/$defs/reviewer" },
        "rubric": { "$ref": "#/$defs/rubric" },
        "independent": { "const": true },
        "decision": { "enum": ["pass", "fail", "n/a"] },
        "disagreement": { "type": "boolean" },
        "adjudication": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/adjudication" }] },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "role", "method"],
      "properties": {
        "id": { "type": "string" },
        "type": { "const": "human" },
        "role": { "type": "string" },
        "method": { "type": "string" }
      }
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "criteria"],
      "properties": { "id": { "type": "string" }, "version": { "type": "string" }, "criteria": {} }
    },
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adjudicator", "rule", "decision", "resolved_at", "rationale"],
      "properties": {
        "adjudicator": { "$ref": "#/$defs/reviewer" },
        "rule": { "type": "string" },
        "decision": { "enum": ["pass", "fail", "n/a"] },
        "resolved_at": { "type": "string", "format": "date-time" },
        "rationale": { "type": "string" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "summary", "details", "sha256"],
      "properties": {
        "mode": { "enum": ["automated", "manual"] },
        "summary": { "type": "string" },
        "details": { "$ref": "#/$defs/safeValue" },
        "subject": { "type": "string" },
        "subject_absent": { "type": "boolean" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_identity", "artifact_sha256", "dependency_manifest_sha256", "subject_inventory_sha256", "captured_at", "tool", "browser", "inspector", "sha256"],
      "properties": {
        "artifact_identity": { "type": "string" },
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "dependency_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "subject_inventory_sha256": { "$ref": "#/$defs/sha256" },
        "captured_at": { "type": "string", "format": "date-time" },
        "tool": { "$ref": "#/$defs/runtime" },
        "browser": { "$ref": "#/$defs/runtime" },
        "inspector": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/inspector" }] },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": { "name": { "type": "string" }, "version": { "type": "string" } }
    },
    "inspector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "method"],
      "properties": { "name": { "type": "string" }, "role": { "type": "string" }, "method": { "type": "string" } }
    },
    "rootIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": { "path": { "type": "string" }, "sha256": { "$ref": "#/$defs/sha256" }, "error": { "type": "string" } }
    },
    "dependencyManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "assets", "sha256"],
      "properties": {
        "entry": { "type": "string" },
        "assets": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"], "properties": { "path": { "type": "string" }, "bytes": { "type": "integer", "minimum": 1 }, "sha256": { "$ref": "#/$defs/sha256" } } } },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "safeValue": {
      "anyOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string", "maxLength": 4096 },
        { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/safeValue" } },
        { "type": "object", "maxProperties": 64, "propertyNames": { "not": { "enum": ["__proto__", "prototype", "constructor"] } }, "additionalProperties": { "$ref": "#/$defs/safeValue" } }
      ]
    }
  }
}

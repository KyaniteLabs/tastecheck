{
  "schema_version": 1,
  "skill": "humanize-copy",
  "class": "generative",
  "trigger": {
    "positive": [
      "UI or product copy is factually correct but generic, hedged, clichéd, or unlike the intended author voice."
    ],
    "negative": [
      "The request requires changing product facts, legal meaning, or interaction behavior."
    ],
    "adjacent_skills": [
      "deslop-ui",
      "form-ux",
      "i18n-ready"
    ]
  },
  "exclusions": [
    "Do not invent claims, testimonials, or product facts.",
    "Do not flatten regulated, safety, or error copy into personality."
  ],
  "inputs": {
    "required": [
      "source copy and facts",
      "audience/action",
      "voice or brief constraints"
    ],
    "optional": [
      "approved terminology",
      "locale",
      "content length limits"
    ]
  },
  "outputs": {
    "primary": "fact-preserving copy revision with voice rationale",
    "artifacts": [
      "before/after copy",
      "fact ledger",
      "voice and rhythm notes",
      "evidence-backed self-check"
    ],
    "handoff_fields": [
      "surface",
      "source_fact",
      "revision",
      "voice_choice",
      "length",
      "evidence"
    ]
  },
  "stop_conditions": [
    "Stop when source facts or approval constraints are missing.",
    "Stop and preserve exact meaning for legal, safety, or validation messages."
  ],
  "handoff": {
    "receives_from": [
      "cognitive-a11y",
      "design-system-interview",
      "deslop-ui",
      "empty-states",
      "improve-existing-website",
      "tasteroll"
    ],
    "sends_to": [
      "form-ux",
      "i18n-ready",
      "tastecheck-pass"
    ]
  },
  "self_check_shape": "table_with_evidence",
  "required_evidence_fields": [
    "status",
    "reason",
    "remediation",
    "evidence",
    "provenance"
  ],
  "context_budget": {
    "skill_md_max_tokens": 5000,
    "resource_max_tokens": 6000
  }
}
